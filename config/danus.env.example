# Copy to config/danus.env (gitignored). Every value is valid shell syntax.
# scripts/env.sh reads config/dsh.env -> config/danus.env; stale runtime.env is ignored.
# Isolated launcher children inherit resolved values without reloading env files.
# No deployment config, login, secrets or global GUI profiles are imported.

# Required explicit neutral defaults; choose model/effort supported by your route.
# DANUS_MAIN_MODEL=your-model
# DANUS_MAIN_EFFORT=high
# DANUS_WORKER_MODEL=your-worker-model
# DANUS_WORKER_EFFORT=high
# Per-service overrides fall back to the neutral main values:
# DANUS_VERIFY_MODEL=your-verifier-model
# DANUS_VERIFY_EFFORT=high
# DANUS_WRITE_PAPER_MODEL=your-renderer-model
# DANUS_WRITE_PAPER_EFFORT=high
# DANUS_HUMAN_SUMMARY_MODEL=your-report-model
# DANUS_HUMAN_SUMMARY_EFFORT=high

DANUS_MAIN_PORT=8090                  # separate operator-launched DSH Web main
VERIFY_PORT=8091
DASHBOARD_PORT=8099
# DANUS_RUNTIME=/absolute/path/runtime
# DANUS_AGENTS_ROOT=/absolute/path/runtime/projects
# VERIFIER_RESULTS_DIR=/absolute/path/runtime/verify-runs
# DANUS_DSH_HOME=/absolute/path/runtime/dsh-home
# DANUS_DSH_AGENTS_HOME=/absolute/path/runtime/dsh-agents
# DANUS_DSH_RUNS_DIR=/absolute/path/runtime/dsh-runs
# DANUS_PY=/absolute/path/.pixi/envs/default/bin/python
# DANUS_ROUND_HARD_TIMEOUT=14400
# DANUS_MAX_ROUNDS=0
# DANUS_SNAPSHOT_AUTO=0             # opt out of new/replayed automatic snapshots
# DANUS_SNAPSHOT_TIMEOUT_SECONDS=120 # child deadline; pending retries after restart
# DANUS_CHROME_BIN=/absolute/path/chromium

# MCP client deadline is 3600000ms; inner authoring timeout must be shorter.
# DANUS_AUTHORING_TIMEOUT_SECONDS=3300
# DANUS_DSH_TIMEOUT_SECONDS=900
